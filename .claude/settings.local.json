{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebSearch",
      "PowerShell($env:GITHUB_TOKEN=\"test-token\"; $env:GITHUB_REPOSITORY=\"test/repo\"; cd D:\\\\Workspace\\\\gitizens\\\\scripts; python -c \"from engine.constants import VALID_TYPES; print\\(VALID_TYPES\\)\")"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/stop-check"
          }
        ]
      }
    ]
  }
}
